~ start
set ConfigManager.item_save = ""
Espero que no venga ningún monstruo...
do AudioManager.play_sfx("res://00_Assets/02_SFX/Knock3.wav")
do AudioManager.await_for_sfx()
Tú: Bueno... Vamos a ver quien es.
do animator.play("door_open_franky")
Frankenstein: ¿Truuuco ooo Maaltraaatoooo?
Vale, parece una persona normal.
Tú: Hola! Me encanta tu disfraz.
Frankenstein: Diisfraaaz?
Uy, pues quizá no.
A ver... El chico de antes me comentó que intentase darles lo que quisiesen
Tú: Bueno... Que te gustaría?
Frankenstein: ¿Truuuco ooo Maaltraaatooo?
Tú: Si, ahora voy.
Vale... ¿Que demonios le doy yo a algo que se parece a Frankenstein?
do GameValues.candy_time_animation.emit()
=> END

~ negociation
Frankenstein: : ¿Truuuco ooo Maaltraaatooo?
- Si
	do GameValues.candy_time_animation.emit()
	Tú: Ahí tienes.
	=> candy_time
- No
	Tú: Ahora voy, dame un momento.
	=> END
=> END

~ candy_time
if ConfigManager.item_save == "" or ConfigManager.item_save == null:
	Frankenstein: Boolsa... ¿Vaciiia?
	Frankenstein: Eso nooo.
	do GameValues.candy_time_animation.emit()
	=> END
elif ConfigManager.item_save == "Calabaza con Vela":
	do animator.play("franky_jumpscare")
	Frankenstein: NOOOOO!
	Frankenstein: FUEEGOO NO GUSTAAAAA!
	Frankenstein: TU NO SEER BUEEENO!
	do GameValues.change_scene_dialogue()
	=> END

else:
	Frankenstein: Graaziaaas.

do AudioManager.play_sfx("res://00_Assets/02_SFX/Close_Door.wav")
do animator.play_backwards("door_open_franky")
do AudioManager.await_for_sfx()
Uf... Parece que le ha gustado...
do GameValues.next_dialogue.emit()
=> END
